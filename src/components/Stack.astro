---
import TechIcon from './TechIcon.astro';
import {stack} from '../lib/content';

// two-letter monogram for tools without a published logo
const monogram = (name: string) =>
  name.replace(/[^A-Za-z ]/g, ' ').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<section class="section" id="stack">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Stack</p>
      <h2>Current stack</h2>
    </div>
    <div class="groups">
      {stack.current.map((g) => (
        <div class="group">
          <h3>{g.name}</h3>
          <ul>
            {g.items.map((item) => (
              <li>
                {item.icon
                  ? <TechIcon name={item.icon} size="1.75rem" class="logo" />
                  : <span class="mono" aria-hidden="true">{monogram(item.name)}</span>}
                <span>{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <dl class="more">
      <dt>Also</dt><dd>{stack.also.join(' · ')}</dd>
      <dt>Earlier</dt><dd>{stack.earlier.join(' · ')}</dd>
    </dl>
  </div>
</section>

<style>
  .groups { display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr)); }
  h3 {
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 400; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--muted); margin-bottom: 1rem;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  li {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 0.6rem;
    background: var(--surface); font-weight: 500; font-size: 0.95rem; line-height: 1.25;
  }
  li :global(.logo) { color: var(--accent); flex-shrink: 0; }
  .more { margin: 3rem 0 0; display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.5rem; color: var(--muted); }
  dt { font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; padding-top: 0.2em; }
  dd { margin: 0; }
  .mono {
    width: 1.75rem; height: 1.75rem; flex-shrink: 0; border-radius: 0.4rem;
    display: grid; place-items: center;
    background: var(--accent-soft); color: var(--accent);
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
  }
</style>
