---
import {Icon} from 'astro-icon/components';
import {aboutMe} from '../lib/content';
---
<section class="section" id="about">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">About</p>
      <h2>About me</h2>
    </div>
    <div class="cols">
      <div class="text">
        {aboutMe.intro.map((p) => <p set:html={p} />)}
        <p class="key">{aboutMe.key}</p>
        {aboutMe.outro.map((p) => <p set:html={p} />)}
      </div>
      <div class="card">
        <h3>{aboutMe.highlights.text}</h3>
        <ul>
          {aboutMe.highlights.bullets.map((b) => (
            <li><Icon name="tabler:circle-check" width="1.2em" height="1.2em" class="check" />{b}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cols { display: grid; gap: 2.5rem; grid-template-columns: 3fr 2fr; align-items: start; }
  .text { display: grid; gap: 1.1rem; color: var(--muted); }
  .key { color: var(--accent); }
  h3 { font-size: 1.1rem; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  li { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; font-size: 0.97rem; }
  li :global(.check) { color: var(--accent); margin-top: 0.2em; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
</style>
