---
import CTA from './CTA.astro';
import Landing from '../../images/landing.svg';
import type {OpenerData} from '../lib/content';

type Props = {opener: OpenerData};
const {lead, q, cta} = Astro.props.opener;
---
<section class="section opener">
  <div class="columns is-desktop opener-content">
    <div class="column">
      <h1 class="title is-size-1">
        Hi, I'm <span class="has-text-primary">Felix</span>
      </h1>
      <div class="content is-size-4 is-size-5-touch">
        <p class="has-text-grey">{lead}</p>
      </div>
      <div class="content is-size-4 is-size-5-touch">
        <p>{q}</p>
        <CTA button={cta} />
      </div>
    </div>
    <div class="column opener-image">
      <Landing />
    </div>
  </div>
  <div class="content is-hidden-mobile">
    <div class="arrow-down">
      <a aria-label="Landing page" href="#services">
        <span></span>
      </a>
    </div>
  </div>
</section>
