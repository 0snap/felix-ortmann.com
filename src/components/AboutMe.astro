---
import CTA from './CTA.astro';
import TechIcon from './TechIcon.astro';
import type {AboutMeData} from '../lib/content';

type Props = {aboutMe: AboutMeData};
const {aboutMe} = Astro.props;
---
<section class="section has-text-centered mb-6" id="about_me">
  <div class="container">
    <h1 class="title is-size-1">
      About <span class="has-text-primary">Me</span>
    </h1>
    <div class="content has-text-justified">
      {aboutMe.paragraphs.map((entry, idx) => {
        const odd = idx % 2 === 1;
        const iconCol = (
          <div class:list={['column is-one-fifths is-hidden-mobile', {'has-text-right': odd}]}>
            <TechIcon name={entry.icon} color={entry.color} size="4rem" style={`transform: rotate(${odd ? 20 : -20}deg)`} />
          </div>
        );
        const emptyCol = <div class="column is-one-fifths is-hidden-mobile" />;
        return (
          <div class="columns mb-4 is-vcentered">
            {odd ? emptyCol : iconCol}
            <div class="column is-three-fifths content mb-1 has-text-justified" set:html={entry.text} />
            {odd ? iconCol : emptyCol}
          </div>
        );
      })}
    </div>

    <div class="divider">
      <hr />
    </div>

    <div class="content has-text-justified aboutme-highlights">
      <h3 class="has-text-weight-bold is-size-4">{aboutMe.highlights.text}</h3>
      {aboutMe.highlights.bullets.map((bullet) => (
        <div class="columns is-mobile mb-0">
          <div class="column is-1 has-text-right">
            <TechIcon name="checkmark" color="#be25ff" />
          </div>
          <div class="column is-11">{bullet}</div>
        </div>
      ))}
    </div>
    <div class="container mt-6 pt-6 is-size-5">
      <p>If this resonates with your needs, let's chat!</p>
      <CTA button="Let's chat!" />
    </div>
  </div>
</section>
