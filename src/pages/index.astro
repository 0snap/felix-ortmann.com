---
import Page from '../layouts/Page.astro';
import Opener from '../components/Opener.astro';
import Certs from '../components/Certs.astro';
import Biz from '../components/Biz.astro';
import AboutMe from '../components/AboutMe.astro';
import Cv from '../components/Cv.astro';
import {aboutMe, biz, cv, opener} from '../lib/content';
---
<Page>
  <Opener opener={opener.opener} />
  <Certs />
  <section class="section mb-6" id="services">
    <Biz tiers={biz.tiers} opener={biz.bizHeadline} />
  </section>
  <AboutMe aboutMe={aboutMe} />
  <section class="section" id="cv">
    <Cv journey={cv.journey} />
  </section>
</Page>
