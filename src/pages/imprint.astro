---
import Page from '../layouts/Page.astro';
import ContactBlock from '../components/ContactBlock.astro';
import {imprint} from '../lib/content';
---
<Page title={imprint.headline}>
  <section class="legal">
    <div class="wrap">
      <h1>{imprint.headline}</h1>
      <ContactBlock title={imprint.contact_headline} />
      {imprint.paragraphs.map((p) => (
        <div class="block">
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>
</Page>
